;;;; tests.lisp -- ghostty-vt test suite (no external framework)
;;;;
;;;; Run with (asdf:test-system "ghostty-vt") or (ghostty-vt/tests:run-tests).

(defpackage #:ghostty-vt/tests
  (:use #:cl #:ghostty-vt)
  (:export #:run-tests))

(in-package #:ghostty-vt/tests)

(defvar *tests* '())

(defmacro deftest (name () &body body)
  `(progn
     (defun ,name () ,@body)
     (setf *tests* (append (remove ',name *tests*) (list ',name)))))

(defmacro is (form &optional description)
  `(unless ,form
     (error "Assertion failed~@[ (~a)~]: ~s" ,description ',form)))

(defmacro is-equal (expected actual &optional description)
  `(let ((e ,expected) (a ,actual))
     (unless (equalp e a)
       (error "Assertion failed~@[ (~a)~]: expected ~s, got ~s~%  in ~s"
              ,description e a ',actual))))

(defun run-tests ()
  "Run every test; print a summary and return true when all passed."
  (let ((failures '()))
    (dolist (test *tests*)
      (handler-case (progn (funcall test) (format t "~&  pass  ~(~a~)~%" test))
        (error (c)
          (push test failures)
          (format t "~&  FAIL  ~(~a~): ~a~%" test c))))
    (format t "~&~d tests, ~d passed, ~d failed~%"
            (length *tests*) (- (length *tests*) (length failures)) (length failures))
    (null failures)))

;;; Helpers

(defun esc (&rest parts)
  "Concatenate PARTS, replacing ~ with ESC."
  (substitute (code-char 27) #\~ (apply #'concatenate 'string parts)))

(defun tilde (string)
  (concatenate 'string string "~"))

(defun octets (&rest codes)
  (coerce codes '(simple-array (unsigned-byte 8) (*))))

(defun bytes->string (octets)
  (map 'string #'code-char octets))

(defun cursor (term)
  (multiple-value-list (terminal-cursor term)))

;;; Tests

(deftest abi-matches-library ()
  (is (ghostty-vt.ffi:check-abi))
  (dolist (entry (ghostty-vt.ffi:abi-type-sizes))
    (destructuring-bind (name lib lisp) entry
      (is-equal lib lisp name))))

(deftest plain-text-lands-in-first-row ()
  (with-terminal (term :rows 4 :columns 20)
    (terminal-feed term "hello")
    (is-equal "hello" (terminal-row-text term 0))
    (is-equal "" (terminal-row-text term 1))
    (is-equal '(0 5 t) (cursor term))
    (is-equal '(104) (cell-codepoints (terminal-cell term 0 0)))
    (is-equal "" (cell-string (terminal-cell term 0 10)))))

(deftest feed-accepts-octets-and-bounds ()
  (with-terminal (term :rows 2 :columns 20)
    (terminal-feed term (octets 120 65 66 67 120) :start 1 :end 4)
    (terminal-feed term "--xyz--" :start 2 :end 5)
    (terminal-feed term (vector 33))
    (is-equal "ABCxyz!" (terminal-row-text term 0))))

(deftest utf8-string-feed ()
  (with-terminal (term :rows 2 :columns 20)
    (terminal-feed term (coerce (list #\a (code-char #xE9) (code-char #x3BB)) 'string))
    (is-equal (coerce (list #\a (code-char #xE9) (code-char #x3BB)) 'string)
              (terminal-row-text term 0))
    (is-equal '(0 3 t) (cursor term))))

(deftest cup-ed-el ()
  (with-terminal (term :rows 5 :columns 10)
    (terminal-feed term (esc "abcdef" (string #\Return) (string #\Newline) "ghijkl"))
    (terminal-feed term (esc "~[1;3H"))
    (is-equal '(0 2 t) (cursor term) "CUP is 1-based")
    (terminal-feed term (esc "~[K"))
    (is-equal "ab" (terminal-row-text term 0) "EL erases to end of line")
    (is-equal "ghijkl" (terminal-row-text term 1))
    (terminal-feed term (esc "~[2;3H~[1K"))
    (is-equal "   jkl    " (terminal-row-text term 1 :trim nil) "EL 1 erases to cursor")
    (terminal-feed term (esc "~[2J"))
    (is-equal "" (terminal-row-text term 0) "ED 2 clears the screen")
    (is-equal "" (terminal-row-text term 1))
    (terminal-feed term (esc "~[3;4HX"))
    (is-equal "X" (cell-string (terminal-cell term 2 3)))
    (is-equal "   X" (terminal-row-text term 2))))

(deftest sgr-palette-and-truecolor ()
  (with-terminal (term :rows 2 :columns 20)
    (terminal-feed term (esc "~[31mR~[38;2;10;20;30mT~[48;5;200mB~[0mN"))
    (is-equal '(:palette 1) (cell-fg (terminal-cell term 0 0)))
    (is-equal '(:rgb 10 20 30) (cell-fg (terminal-cell term 0 1)))
    (is-equal '(:palette 200) (cell-bg (terminal-cell term 0 2)))
    (is-equal '(:rgb 10 20 30) (cell-fg (terminal-cell term 0 2)))
    (let ((plain (terminal-cell term 0 3)))
      (is-equal '(:default) (cell-fg plain))
      (is-equal '(:default) (cell-bg plain))
      (is-equal '() (cell-attrs plain)))))

(deftest erase-with-background-colors-blank-cells ()
  (with-terminal (term :rows 2 :columns 10)
    (terminal-feed term (esc "~[44m~[K"))
    (is-equal '(:palette 4) (cell-bg (terminal-cell term 0 5)))
    (is-equal '() (cell-codepoints (terminal-cell term 0 5)))))

(deftest bold-inverse-and-underline-attrs ()
  (with-terminal (term :rows 2 :columns 20)
    (terminal-feed term (esc "~[1mA~[7mB~[0;4mC~[4:2mD~[0;3;9mE"))
    (is-equal '(:bold) (cell-attrs (terminal-cell term 0 0)))
    (is-equal '(:bold :inverse) (cell-attrs (terminal-cell term 0 1)))
    (is-equal '(:underline) (cell-attrs (terminal-cell term 0 2)))
    (is-equal '(:double-underline) (cell-attrs (terminal-cell term 0 3)))
    (is-equal '(:italic :strike) (cell-attrs (terminal-cell term 0 4)))))

(deftest wide-character-and-spacer ()
  (with-terminal (term :rows 2 :columns 10)
    (terminal-feed term (string (code-char #x4E2D)))
    (let ((head (terminal-cell term 0 0))
          (tail (terminal-cell term 0 1)))
      (is-equal :wide (cell-width head))
      (is-equal (list #x4E2D) (cell-codepoints head))
      (is-equal :spacer-tail (cell-width tail))
      (is-equal '() (cell-codepoints tail)))
    (is-equal '(0 2 t) (cursor term))
    (is-equal (string (code-char #x4E2D)) (terminal-row-text term 0))))

(deftest combining-character-grapheme ()
  (with-terminal (term :rows 2 :columns 10)
    (terminal-feed term (coerce (list #\e (code-char #x301) #\x) 'string))
    (let ((cell (terminal-cell term 0 0)))
      (is-equal '(#x65 #x301) (cell-codepoints cell))
      (is-equal :narrow (cell-width cell)))
    (is-equal '(#x78) (cell-codepoints (terminal-cell term 0 1)))
    (is-equal '(0 2 t) (cursor term))))

(deftest cursor-position-and-visibility ()
  (with-terminal (term :rows 10 :columns 20)
    (terminal-feed term (esc "~[5;10H"))
    (is-equal '(4 9 t) (cursor term))
    (terminal-feed term (esc "~[?25l"))
    (is-equal '(4 9 nil) (cursor term))
    (terminal-feed term (esc "~[99;99H"))
    (is-equal '(9 19 nil) (cursor term) "CUP clamps to the screen")))

(deftest device-attributes-reply-via-pty-write ()
  (let ((replies '()))
    (with-terminal (term :on-pty-write (lambda (octets) (push octets replies)))
      (terminal-feed term (esc "~[c"))
      (is (= 1 (length replies)) "one reply")
      (let ((reply (bytes->string (first replies))))
        (is (eql 0 (search (esc "~[?") reply)) reply)
        (is (char= #\c (char reply (1- (length reply)))) reply))
      (setf replies '())
      (terminal-feed term (esc "~[3;5H~[6n"))
      (is-equal (esc "~[3;5R") (bytes->string (first replies)) "DSR cursor report"))))

(deftest title-via-osc-and-bell ()
  (let ((titles '()) (bells 0))
    (with-terminal (term :on-title (lambda (title) (push title titles))
                         :on-bell (lambda () (incf bells)))
      (is-equal "" (terminal-title term))
      (terminal-feed term (esc "~]2;hello world" (string (code-char 7))))
      (is-equal "hello world" (terminal-title term))
      (is-equal '("hello world") titles)
      (terminal-feed term (esc "~]0;" (string (code-char #x3BB)) "~\\"))
      (is-equal (string (code-char #x3BB)) (terminal-title term))
      (is-equal 0 bells)
      (terminal-feed term (string (code-char 7)))
      (is-equal 1 bells))))

(deftest callback-errors-are-resignalled ()
  (with-terminal (term :on-bell (lambda () (error "boom")))
    (let ((signalled nil))
      (handler-case (terminal-feed term (string (code-char 7)))
        (error (c) (setf signalled (princ-to-string c))))
      (is-equal "boom" signalled))
    ;; The terminal still works afterwards.
    (setf (terminal-bell-function term) nil)
    (terminal-feed term (esc "ok" (string (code-char 7))))
    (is-equal "ok" (terminal-row-text term 0))))

(deftest resize-changes-dimensions ()
  (with-terminal (term :rows 5 :columns 10)
    (is-equal 5 (terminal-rows term))
    (is-equal 10 (terminal-columns term))
    (terminal-feed term "abc")
    (terminal-resize term 8 20)
    (is-equal 8 (terminal-rows term))
    (is-equal 20 (terminal-columns term))
    (is-equal "abc" (terminal-row-text term 0))
    (terminal-feed term (esc "~[8;20HZ"))
    (is-equal "Z" (cell-string (terminal-cell term 7 19)))
    (is (typep (nth-value 1 (ignore-errors (terminal-cell term 8 0))) 'ghostty-error)
        "out-of-bounds cell signals")))

(deftest screen-text-uses-formatter ()
  (with-terminal (term :rows 5 :columns 20)
    (terminal-feed term (format nil "line one   ~C~Cline two" #\Return #\Newline))
    (is-equal (format nil "line one~%line two") (terminal-screen-text term))))

(deftest key-encoding-follows-cursor-key-mode ()
  (with-terminal (term)
    (is-equal (esc "~[A") (bytes->string (encode-key term :up)))
    (is (not (terminal-mode term 1)))
    (terminal-feed term (esc "~[?1h"))
    (is (terminal-mode term 1) "DECCKM set")
    (is-equal (esc "~OA") (bytes->string (encode-key term :up)))
    (is-equal (esc "~OD") (bytes->string (encode-key term :left)))
    (terminal-feed term (esc "~[?1l"))
    (is-equal (esc "~[B") (bytes->string (encode-key term :down)))))

(deftest key-encoding-basics ()
  (with-terminal (term)
    (is-equal "a" (bytes->string (encode-key term #\a)))
    (is-equal "A" (bytes->string (encode-key term #\A)))
    (is-equal "?" (bytes->string (encode-key term #\?)))
    (is-equal (string (code-char 3)) (bytes->string (encode-key term #\c :mods '(:ctrl))))
    (is-equal (esc "~x") (bytes->string (encode-key term #\x :mods '(:alt))))
    (is-equal (string #\Return) (bytes->string (encode-key term :enter)))
    (is-equal (string #\Tab) (bytes->string (encode-key term :tab)))
    (is-equal (string (code-char 127)) (bytes->string (encode-key term :backspace)))
    (is-equal (esc "~") (bytes->string (encode-key term :escape)))
    (is-equal (esc "~OP") (bytes->string (encode-key term :f1)))
    (is-equal (tilde (esc "~[15")) (bytes->string (encode-key term :f5)))
    (is-equal (tilde (esc "~[3")) (bytes->string (encode-key term :delete)))
    (is-equal (tilde (esc "~[5")) (bytes->string (encode-key term :page-up)))
    (is-equal (esc "~[1;5C") (bytes->string (encode-key term :right :mods '(:ctrl))))
    (is-equal (string (code-char #x3BB))
              (babel:octets-to-string (encode-key term (code-char #x3BB))
                                      :encoding :utf-8))
    (is-equal 0 (length (encode-key term :up :action :release)))))

(deftest two-terminals-at-once ()
  (let ((a-replies '()) (b-replies '()))
    (with-terminal (a :rows 3 :columns 10 :on-pty-write (lambda (o) (push o a-replies)))
      (with-terminal (b :rows 6 :columns 30 :on-pty-write (lambda (o) (push o b-replies)))
        (terminal-feed a "alpha")
        (terminal-feed b (esc "~[2;2Hbeta"))
        (terminal-feed a (esc "~[6n"))
        (terminal-feed b (esc "~[6n"))
        (is-equal "alpha" (terminal-row-text a 0))
        (is-equal "" (terminal-row-text b 0))
        (is-equal " beta" (terminal-row-text b 1))
        (is-equal (list (esc "~[1;6R")) (mapcar #'bytes->string a-replies))
        (is-equal (list (esc "~[2;6R")) (mapcar #'bytes->string b-replies))
        (is-equal 10 (terminal-columns a))
        (is-equal 30 (terminal-columns b))))))

(deftest terminals-on-separate-threads ()
  (let* ((results (make-array 4 :initial-element nil))
         (threads
           (loop for i below 4
                 collect (let ((i i))
                           (bt:make-thread
                            (lambda ()
                              (let ((replies '()))
                                (with-terminal (term :rows 4 :columns 20
                                                     :on-pty-write (lambda (o) (push o replies)))
                                  (dotimes (n 200)
                                    (terminal-feed term (esc (format nil "~~[H~D-~D~~[6n" i n))))
                                  (setf (aref results i)
                                        (list (terminal-row-text term 0)
                                              (length replies)))))))))))
    (mapc #'bt:join-thread threads)
    (dotimes (i 4)
      (is-equal (list (format nil "~D-199" i) 200) (aref results i)))))

(deftest freed-terminal-is-rejected ()
  (let ((term (make-terminal)))
    (terminal-free term)
    (terminal-free term)
    (is (not (terminal-live-p term)))
    (is (nth-value 1 (ignore-errors (terminal-feed term "x"))))))

(deftest libffi-fallback-matches-shim ()
  ;; By-value calls go through the C shim when it is loaded and through
  ;; cffi-libffi otherwise; both paths must agree.
  (with-terminal (term :rows 3 :columns 10)
    (terminal-feed term (esc "~[1;32mok" (string #\Return) (string #\Newline) "two"))
    (flet ((snapshot ()
             (list (terminal-cell term 0 0) (terminal-row-text term 1)
                   (terminal-screen-text term))))
      (let ((with-shim (snapshot))
            (without (let ((ghostty-vt.ffi:*shim-path* nil)) (snapshot))))
        (is-equal with-shim without)
        (is-equal (format nil "ok~%two") (third without))))))
